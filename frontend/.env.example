# Локальная разработка. Настоящей авторизации через Telegram ещё нет: без initData
# приложение в dev автоматически входит через локальные MSW-моки (демо-вход с баннером).
# true  — моки всегда, даже внутри Telegram;
# false — всегда настоящий бэкенд (без автодовхода);
# без значения — моки включаются сами, только если Telegram initData отсутствует.
VITE_MSW_ENABLED=false
