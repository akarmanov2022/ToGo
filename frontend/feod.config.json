{
  "srcRoot": "src",
  "aliasPrefix": "@",
  "aliasRoot": "src",
  "modulePages": false,
  "singleFileModules": false,
  "ignore": ["src/common/api/schema.ts"],
  "common": { "maxDepth": 1 },
